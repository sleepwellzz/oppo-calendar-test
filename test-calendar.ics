BEGIN:VCALENDAR
PRODID:-//Proma//OPPO Calendar Compatibility Test//ZH-CN
VERSION:2.0
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:OPPO 日历兼容性测试
X-WR-TIMEZONE:Asia/Shanghai
REFRESH-INTERVAL;VALUE=DURATION:PT15M
X-PUBLISHED-TTL:PT15M
BEGIN:VEVENT
UID:timed-relative-alarm.22074afe596341b9a235c9050af3addf@oppo-test.proma
DTSTAMP:20260811T160347Z
LAST-MODIFIED:20260811T160347Z
SEQUENCE:1
DTSTART:20260811T163400Z
DTEND:20260811T170400Z
SUMMARY:测试 1/5｜定时事件：提前 1 分钟提醒
DESCRIPTION:虚构的日历兼容性测试，不含任何真实姓名或生
 日。时间基准：北京时间（UTC+08:00）。\n用于验证定时 VE
 VENT 与相对 VALARM。
STATUS:CONFIRMED
CLASS:PRIVATE
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT1M
DESCRIPTION:测试 1：如果你收到此通知，说明"定时事件 + 提
 前 1 分钟"有效。
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:all-day-absolute-alarm.22074afe596341b9a235c9050af3addf@oppo-test.proma
DTSTAMP:20260811T160347Z
LAST-MODIFIED:20260811T160347Z
SEQUENCE:1
DTSTART;VALUE=DATE:20260813
DTEND;VALUE=DATE:20260814
SUMMARY:测试 2/5｜全日事件：绝对时刻提醒
DESCRIPTION:虚构的日历兼容性测试，不含任何真实姓名或生
 日。时间基准：北京时间（UTC+08:00）。\n用于验证全日 VE
 VENT 能否执行绝对 UTC VALARM。
STATUS:CONFIRMED
CLASS:PRIVATE
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;VALUE=DATE-TIME:20260811T163900Z
DESCRIPTION:测试 2：如果你收到此通知，说明"全日事件 + 指
 定北京时间提醒"有效。
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:all-day-multiple-alarms.22074afe596341b9a235c9050af3addf@oppo-test.prom
 a
DTSTAMP:20260811T160347Z
LAST-MODIFIED:20260811T160347Z
SEQUENCE:1
DTSTART;VALUE=DATE:20260814
DTEND;VALUE=DATE:20260815
SUMMARY:测试 3/5｜全日事件：两次提醒
DESCRIPTION:虚构的日历兼容性测试，不含任何真实姓名或生
 日。时间基准：北京时间（UTC+08:00）。\n用于验证同一事
 件能否保留和触发多个 VALARM。
STATUS:CONFIRMED
CLASS:PRIVATE
TRANSP:TRANSPARENT
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;VALUE=DATE-TIME:20260811T164400Z
DESCRIPTION:测试 3A：这是同一全日事件的第 1 次提醒。
END:VALARM
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER;VALUE=DATE-TIME:20260811T164600Z
DESCRIPTION:测试 3B：这是同一全日事件的第 2 次提醒。
END:VALARM
END:VEVENT
BEGIN:VEVENT
UID:title-update.22074afe596341b9a235c9050af3addf@oppo-test.proma
DTSTAMP:20260811T160347Z
LAST-MODIFIED:20260811T160347Z
SEQUENCE:1
DTSTART;VALUE=DATE:20260815
DTEND;VALUE=DATE:20260816
SUMMARY:测试 4/5｜标题更新版本 1
DESCRIPTION:虚构的日历兼容性测试，不含任何真实姓名或生
 日。时间基准：北京时间（UTC+08:00）。\n后续可手动修改
  ICS 文件标题版本号，观察 OPPO 是否自动更新。
STATUS:CONFIRMED
CLASS:PRIVATE
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:cancellation.22074afe596341b9a235c9050af3addf@oppo-test.proma
DTSTAMP:20260811T160347Z
LAST-MODIFIED:20260811T160347Z
SEQUENCE:1
DTSTART;VALUE=DATE:20260816
DTEND;VALUE=DATE:20260817
SUMMARY:测试 5/5｜稍后测试取消/删除
DESCRIPTION:虚构的日历兼容性测试，不含任何真实姓名或生
 日。时间基准：北京时间（UTC+08:00）。\n后续可手动修改
  ICS 文件为 STATUS:CANCELLED 或完全移除此事件，观察 OPPO 行
 为。
STATUS:CONFIRMED
CLASS:PRIVATE
TRANSP:TRANSPARENT
END:VEVENT
END:VCALENDAR
